# Karakeep Telegram Bot — Configuration
# Copy this to .env and fill in your values.

# Required: Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Required: Your Karakeep instance URL
KARAKEEP_URL=https://your-karakeep-instance.example.com

# Optional: Karakeep API key (or set via /setkey command in chat)
KARAKEEP_TOKEN=

# Optional: Comma-separated Telegram user IDs to restrict access
ALLOWED_USER_IDS=

# Optional: Seconds between retry attempts (default: 60)
RETRY_INTERVAL=60

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
